**/bin/
**/obj/
.vs/
*.user
# Generated by the integrated local preview of the frontend repository.
Portfolio.Api/wwwroot/
# Local data (visits, error history, geolocation database, backups): never commit it.
App_Data/
# Published content: only the language files and the images saved by the editor, with the names the API generates.
# Anything else in content/ (temporary files of a save in progress) stays local.
/content/*
!/content/portfolio.json
!/content/portfolio.*.json
!/content/uploads/
/content/uploads/*
!/content/uploads/.gitkeep
!/content/uploads/*.png
!/content/uploads/*.jpg
!/content/uploads/*.webp
.test-data/
.dotnet/
.logs/
publish/
.env
